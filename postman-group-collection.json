{
  "info": {
    "_postman_id": "notifications-service-001",
    "name": "Notifications Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "", "type": "string" },
    { "key": "groupId", "value": "1", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "pixPaymentId",    "value": "", "type": "string" },
    { "key": "pixQrCodeId",     "value": "", "type": "string" },
    { "key": "abacatePayApiKey","value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gabriel\",\n  \"email\": \"gabriel@test.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\",\n  \"timezone\": \"America/Sao_Paulo\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gabriel@test.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Editar nome",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/edit-name",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "edit-name"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novo Nome\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Grupos",
      "item": [
        {
          "name": "Buscar grupo por código",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/group/code/:code",
              "host": ["{{baseUrl}}"],
              "path": ["group", "code", ":code"],
              "variable": [{ "key": "code", "value": "ABC123" }]
            }
          }
        },
        {
          "name": "Criar grupo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('groupId', json.id);",
                  "  console.log('groupId salvo:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group",
              "host": ["{{baseUrl}}"],
              "path": ["group"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meu Grupo\",\n  \"description\": \"Descrição do grupo\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Editar grupo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novo Nome do Grupo\",\n  \"description\": \"Nova descrição\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Entrar em grupo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/join",
              "host": ["{{baseUrl}}"],
              "path": ["group", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": {{groupId}}\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sair do grupo (membro)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/leave",
              "host": ["{{baseUrl}}"],
              "path": ["group", "leave"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": {{groupId}}\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sair do grupo (dono — transfere ownership)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/leave",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "leave"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nextOwnerId\": 2\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Meus grupos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/group/user",
              "host": ["{{baseUrl}}"],
              "path": ["group", "user"]
            }
          }
        },
        {
          "name": "Membros do grupo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "users"]
            }
          }
        },
        {
          "name": "Remover membro (adm)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/users/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "users", ":userId"],
              "variable": [{ "key": "userId", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Pagamentos (PIX)",
      "item": [
        {
          "name": "Gerar QR Code PIX",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('pixPaymentId', json.id);",
                  "  console.log('pixPaymentId salvo:', json.id);",
                  "}",
                  "if (json.pixBrCode) {",
                  "  console.log('PIX copia-e-cola:', json.pixBrCode);",
                  "}",
                  "// Extrair o ID do QR code do Abacate Pay a partir do external_id",
                  "// Use este ID para simular o pagamento"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/group/{{groupId}}/pix",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "group", "{{groupId}}", "pix"]
            }
          }
        },
        {
          "name": "Histórico de pagamentos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment/group/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "group", "{{groupId}}"]
            }
          }
        },
        {
          "name": "Simular pagamento (sandbox Abacate Pay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{abacatePayApiKey}}", "type": "text" }
            ],
            "url": {
              "raw": "https://api.abacatepay.com/v1/pixQrCode/simulate-payment?id={{pixQrCodeId}}",
              "protocol": "https",
              "host": ["api", "abacatepay", "com"],
              "path": ["v1", "pixQrCode", "simulate-payment"],
              "query": [{ "key": "id", "value": "{{pixQrCodeId}}" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verificar assinatura do grupo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/subscription",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "subscription"]
            }
          }
        }
      ]
    },
    {
      "name": "Planos",
      "item": [
        {
          "name": "Listar planos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": ["{{baseUrl}}"],
              "path": ["plans"]
            }
          }
        }
      ]
    },
    {
      "name": "Notificações",
      "item": [
        {
          "name": "Criar notificação",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('notificationId', json.id);",
                  "  console.log('notificationId salvo:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "notifications"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aniversário da empresa\",\n  \"description\": \"Comemoramos mais um ano!\",\n  \"month\": 8,\n  \"day\": 15\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Listar notificações do grupo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "notifications"]
            }
          }
        },
        {
          "name": "Editar notificação",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/notifications/{{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "notifications", "{{notificationId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nome atualizado\",\n  \"description\": \"Nova descrição\",\n  \"month\": 9,\n  \"day\": 20\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Deletar notificação",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/group/{{groupId}}/notifications/{{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["group", "{{groupId}}", "notifications", "{{notificationId}}"]
            }
          }
        }
      ]
    }
  ]
}
